{
  "name": "portfolio-manager",
  "version": "1.0.0",
  "description": "سیستم مدیریت صندوق سبدگردانی",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "vue-tsc --noEmit",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "vitest run tests/core",
    "test:db": "npm rebuild better-sqlite3 && vitest run tests/data"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.38.3",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
