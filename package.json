{
  "name": "portfolio-manager",
  "version": "1.0.0",
  "description": "سیستم مدیریت صندوق سبدگردانی",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "vue-tsc --noEmit",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "vitest run tests/core",
    "test:db": "npm rebuild better-sqlite3 && vitest run tests/data"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.38.3",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
