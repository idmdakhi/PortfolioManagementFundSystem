@include('partials/head')
@if(auth.user.role == 'admin')
<div class="card"><h2>ثبت صدور یا ابطال (NAV فعلی: {{ fa2(st.current.summary.nav) }})</h2>
<form method="POST" action="/transactions">{{ csrfField() }}<div class="g">
<div><label>سرمایه‌گذار</label><select name="investorId">
@each(i in st.investors)
<option value="{{ i.id }}" {{ false ? 'selected' : '' }}>{{ i.name }}</option>
@end
</select></div>
<div><label>نوع</label><select name="type"><option value="issue" {{ false ? 'selected' : '' }}>{{ typeFa('issue') }}</option><option value="redeem" {{ false ? 'selected' : '' }}>{{ typeFa('redeem') }}</option></select></div>
<div><label>مبلغ (ریال)</label><input class="money" inputmode="numeric" name="amount" value="{{ '' }}" required></div>
<div><label>NAV (خالی = NAV فعلی)</label><input class="money" inputmode="decimal" name="nav" value="{{ '' }}"></div>
<div><label>تاریخ شمسی</label><input name="occurredOn" dir="ltr" placeholder="1405/07/21" value="{{ today }}"></div>
<div><label>یادداشت</label><input name="note" value="{{ '' }}"></div></div><p><button>ثبت</button></p></form>
<div class="sub">تاریخ باید داخل دورهٔ مالی باز باشد. تراکنش‌های دورهٔ بسته قفل هستند.</div></div>
@end
<div class="card sc"><table><tr><th>تاریخ</th><th>نام</th><th>نوع</th><th class="num">مبلغ</th><th class="num">NAV</th><th class="num">واحد</th><th>یادداشت</th><th></th></tr>
@each(t in txs)
<tr><td>{{ jd(t.occurredOn) }}</td><td>{{ names.get(t.investorId) }}</td><td>{{ typeFa(t.type) }}</td><td class="num">{{ fa(t.amount) }}</td><td class="num">{{ fa2(t.nav) }}</td><td class="num">{{ fa2(t.units) }}</td><td>{{ t.note || '' }}</td>
<td>
@if(t.batchId)
<a class="badge" href="/movements">گروهی</a>
@elseif(auth.user.role == 'admin' && !t.locked)
<div class="acts"><a class="btn sm o" href="/transactions/{{ t.id }}/edit">ویرایش</a>
<form method="POST" action="/transactions/{{ t.id }}/delete" data-confirm="این تراکنش حذف شود؟">{{ csrfField() }}<button class="sm danger">حذف</button></form></div>
@elseif(t.locked)
<span class="sub">قفل (دورهٔ بسته)</span>
@end
</td></tr>
@else
<tr><td colspan="8" class="sub">هنوز تراکنشی ثبت نشده.</td></tr>
@end
</table></div>
@include('partials/foot')
