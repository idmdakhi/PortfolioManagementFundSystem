<tr><td><form id="f{{ o.id }}" method="POST" action="/options/{{ o.id }}">{{ csrfField() }}</form><input form="f{{ o.id }}" name="label" value="{{ o.label }}" required></td><td><input form="f{{ o.id }}" name="sort" type="number" value="{{ o.sort }}" style="width:80px"></td>
