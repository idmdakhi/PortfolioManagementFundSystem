@end
</table>
<form method="POST" action="/options"><br>{{ csrfField() }}<input type="hidden" name="list" value="area_kind"><div class="g"><div><label>نوع جدید (مثلاً سهام، طلا، سپرده)</label><input name="label" required></div></div><p><button class="sm">افزودن نوع</button></p></form></div>

