@include('partials/head')
<div class="card sc"><h2>حساب‌های شخصی — دورهٔ {{ rep.period.label }}</h2><table><tr><th>نام</th><th class="num">سرمایه</th><th class="num">ارزش روز</th><th class="num">سود تقسیمی</th><th class="num">سود ناخالص</th><th class="num">کارمزد</th><th class="num">سود خالص</th><th class="num">بازده</th></tr>
@each(r in rep.rows)
@if(r.personal)
<tr><td><a href="/investors/{{ r.id }}/personal">{{ r.name }}</a></td><td class="num">{{ fa(r.personal.capital) }}</td><td class="num">{{ fa(r.personalRaw.marketValue) }}</td><td class="num">{{ fa(r.personalDividends) }}</td><td class="num">{{ fa(r.personal.gross) }}</td><td class="num">{{ fa(r.personal.fee) }}</td><td class="num {{ cls(r.personal.net) }}">{{ fa(r.personal.net) }}</td><td class="num">{{ pct(r.personal.returnPct) }}</td></tr>
@end
@end
</table></div>
<div class="card sc"><h2>سود و زیان خالص حساب شخصی به تفکیک دوره (پس از کارمزد)</h2><table><tr><th>نام</th>
@each(r in st.reports)
<th class="num">{{ r.period.label }}</th>
@end
</tr>
@each(inv in st.investors)
<tr><td><a href="/investors/{{ inv.id }}/personal">{{ inv.name }}</a></td>
@each(r in st.reports)
@let(pr = r.rows.find((x) => x.id == inv.id).personal)
<td class="num {{ pr ? cls(pr.net) : '' }}">{{ pr ? fa(pr.net) : '—' }}</td>
@end
</tr>
@end
</table></div>
@include('partials/foot')
