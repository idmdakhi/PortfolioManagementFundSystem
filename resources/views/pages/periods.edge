@include('partials/head')
<div class="card sc"><h2>سود و زیان صندوق به تفکیک دوره</h2><table><tr><th>دوره</th><th>وضعیت</th><th class="num">سرمایه</th><th class="num">ارزش پایانی</th><th class="num">سود تقسیمی</th><th class="num">سود ناخالص</th><th class="num">کارمزد</th><th class="num">سود خالص</th><th class="num">بازده</th><th class="num">NAV</th></tr>
@each(r in st.reports)
<tr><td><a href="/?p={{ r.period.id }}">{{ r.period.label }}</a></td><td><span class="badge {{ r.period.status == 'open' ? '' : 'cl' }}">{{ r.period.status == 'open' ? 'باز' : 'بسته' }}</span></td><td class="num">{{ fa(r.summary.capital) }}</td><td class="num">{{ fa(r.params.marketValue) }}</td><td class="num">{{ fa(r.params.dividends) }}</td><td class="num">{{ fa(r.summary.gross) }}</td><td class="num">{{ fa(r.summary.fee) }}</td><td class="num">{{ fa(r.summary.profit) }}</td><td class="num">{{ pct(r.summary.returnPct) }}</td><td class="num">{{ fa2(r.summary.nav) }}</td></tr>
@end
</table></div>
<div class="card sc"><h2>سود و زیان خالص هر سرمایه‌گذار در صندوق (حساب صندوقی)</h2><table><tr><th>نام</th>
@each(r in st.reports)
<th class="num">{{ r.period.label }}</th>
@end
</tr>
@each(inv in st.investors)
<tr><td><a href="/investors/{{ inv.id }}">{{ inv.name }}</a></td>
@each(r in st.reports)
<td class="num {{ cls(r.rows.find((x) => x.id == inv.id).fund.net) }}">{{ fa(r.rows.find((x) => x.id == inv.id).fund.net) }}</td>
@end
</tr>
@end
</table></div>
<div class="card sc"><h2>سوابق قبل از سیستم</h2><table><tr><th>سال</th><th class="num">بازدهی (٪)</th><th class="num">کارمزد سبدگردان</th><th></th></tr>
@each(h in st.history)
@if(auth.user.role == 'admin')
<tr><td><form id="h{{ h.id }}" method="POST" action="/history/{{ h.id }}">{{ csrfField() }}</form><input form="h{{ h.id }}" name="label" value="{{ h.label }}" style="width:90px"></td>
<td class="num"><input form="h{{ h.id }}" name="returnPct" inputmode="decimal" value="{{ h.returnPct }}" style="width:110px"></td>
<td class="num"><input form="h{{ h.id }}" class="money" inputmode="numeric" name="fee" value="{{ money(h.fee) }}" style="width:170px"></td>
<td><div class="acts"><button form="h{{ h.id }}" class="sm">ذخیره</button><form method="POST" action="/history/{{ h.id }}/delete" data-confirm="حذف شود؟">{{ csrfField() }}<button class="sm danger">حذف</button></form></div></td></tr>
@else
<tr><td>{{ h.label }}</td><td class="num pos">{{ fa2(h.returnPct) }}</td><td class="num">{{ fa(h.fee) }}</td><td></td></tr>
@end
@end
</table>
@if(auth.user.role == 'admin')
<form method="POST" action="/history"><br>{{ csrfField() }}<div class="g"><div><label>سال</label><input name="label" required></div><div><label>بازدهی (٪)</label><input name="returnPct" inputmode="decimal" required></div><div><label>کارمزد (ریال)</label><input class="money" inputmode="numeric" name="fee" value="0"></div></div><p><button class="sm">افزودن سال</button> <a href="/periods/manage">مدیریت دوره‌ها</a></p></form>
@end
</div>
@include('partials/foot')
