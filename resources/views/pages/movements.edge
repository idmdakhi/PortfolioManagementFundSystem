@include('partials/head')
@if(auth.user.role == 'admin')
<div class="card"><h2>ثبت حرکت گروهی</h2>
<div class="sub">یک مبلغ را بین چند نفر تقسیم و از مبدأ به مقصد منتقل کنید. مثال: واریز تازه به صندوق برای چند نفر، یا برداشت از صندوق و واریز به یک ملک.</div>
<form method="POST" action="/movements">{{ csrfField() }}<br><div class="g">
<div><label>از (مبدأ)</label><select name="from"><option value="fund" selected>صندوق (ابطال واحد)</option>
@each(a in st.areas)
<option value="area:{{ a.id }}">حوزه: {{ a.name }}</option>
@end
@each(p in opts('external_place'))
<option value="ext:{{ p.value }}">{{ p.label }}</option>
@end
</select></div>
<div><label>به (مقصد)</label><select name="to"><option value="fund">صندوق (صدور واحد)</option>
@each(a in st.areas)
<option value="area:{{ a.id }}">حوزه: {{ a.name }}</option>
@end
@each(p in opts('external_place'))
<option value="ext:{{ p.value }}">{{ p.label }}</option>
@end
</select></div>
<div><label>روش تقسیم</label><select name="method">
@each(mt in opts('split_method'))
<option value="{{ mt.value }}">{{ mt.label }}</option>
@end
</select></div>
<div><label>مبلغ کل (ریال) — برای «مبلغ جداگانه» لازم نیست</label><input class="money" inputmode="numeric" name="total"></div>
<div><label>تاریخ شمسی</label><input name="occurredOn" dir="ltr" value="{{ today }}"></div>
<div><label>یادداشت</label><input name="note"></div></div>
<div class="sc"><table><tr><th>انتخاب</th><th>سرمایه‌گذار</th><th class="num">مقدار (درصد، مبلغ یا وزن بسته به روش؛ در روش‌های خودکار خالی)</th></tr>
@each(i in st.investors)
<tr><td><input type="checkbox" name="sel_{{ i.id }}" style="width:auto"></td><td>{{ i.name }}</td><td><input class="money" inputmode="decimal" name="val_{{ i.id }}" style="max-width:220px"></td></tr>
@end
</table></div>
<p><button>ثبت</button></p></form>
