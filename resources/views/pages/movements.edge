@end
<div class="card sc"><h2>حرکت‌های گروهی ثبت‌شده</h2><table><tr><th>تاریخ</th><th>از</th><th>به</th><th>روش</th><th>یادداشت</th><th class="num">نفرات</th><th class="num">اثر روی صندوق</th><th class="num">اثر روی حوزه‌ها</th><th></th></tr>
@each(g in list)
<tr><td>{{ jd(g.date) }}</td><td>{{ g.from }}</td><td>{{ g.to }}</td><td>{{ g.method }}</td><td>{{ g.note || '' }}</td><td class="num">{{ fa(g.people.size) }}</td><td class="num {{ cls(g.fund) }}">{{ fa(g.fund) }}</td><td class="num {{ cls(g.area) }}">{{ fa(g.area) }}</td>
<td>
@if(auth.user.role == 'admin' && !g.locked)
<div class="acts"><a class="btn sm o" href="/movements/{{ g.batchId }}/edit">ویرایش</a>
<form method="POST" action="/movements/{{ g.batchId }}/delete" data-confirm="کل این گروه حذف شود؟">{{ csrfField() }}<button class="sm danger">حذف گروه</button></form></div>
@elseif(g.locked)
<span class="sub">قفل (دورهٔ بسته)</span>
@end
</td></tr>
