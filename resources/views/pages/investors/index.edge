</span></td><td class="num">{{ fa2(r.unitsEnd) }}</td><td class="num">{{ pct(r.share) }}</td><td class="num">{{ fa(r.cost) }}</td><td class="num">{{ fa(r.fund.value) }}</td><td class="num {{ cls(r.fund.net) }}">{{ fa(r.fund.net) }}</td></tr>
