@include('partials/head')
<h2>{{ name }} — حساب صندوق</h2>
<div class="chips noprint"><a href="/investors/{{ id }}" class="on">حساب صندوق</a><a href="/investors/{{ id }}/personal" class="">حساب شخصی</a><a href="/investors/{{ id }}/report">گزارش چاپی برای مشتری</a></div>
<div class="card sc"><h2>حساب در صندوق — به تفکیک دوره</h2><table><tr><th>دوره</th><th class="num">واحد</th><th class="num">سرمایه</th><th class="num">ارزش (پس از کارمزد)</th><th class="num">سود تقسیمی</th><th class="num">سود ناخالص</th><th class="num">سود ثابت</th><th class="num">مازاد</th><th class="num">سهم کارمزد</th><th class="num">سود خالص</th><th class="num">بازده</th></tr>
@each(l in lines)
<tr><td>{{ l.period.label }}</td><td class="num">{{ fa2(l.row.unitsEnd) }}</td><td class="num">{{ fa(l.row.fund.capital) }}</td><td class="num">{{ fa(l.row.fund.value) }}</td><td class="num">{{ fa(l.row.fundDividends) }}</td><td class="num">{{ fa(l.row.fund.gross) }}</td><td class="num">{{ fa(l.row.fund.fixed) }}</td><td class="num">{{ fa(l.row.fund.excess) }}</td><td class="num">{{ fa(l.row.fund.feeShare) }}</td><td class="num {{ cls(l.row.fund.net) }}">{{ fa(l.row.fund.net) }}</td><td class="num">{{ pct(l.row.fund.returnPct) }}</td></tr>
@end
</table></div>
<div class="card sc"><h2>تراکنش‌های صندوق</h2><table><tr><th>تاریخ</th><th>نوع</th><th class="num">مبلغ</th><th class="num">NAV</th><th class="num">واحد</th><th>یادداشت</th></tr>
@each(t in txs)
<tr><td>{{ jd(t.occurredOn) }}</td><td>{{ typeFa(t.type) }}</td><td class="num">{{ fa(t.amount) }}</td><td class="num">{{ fa2(t.nav) }}</td><td class="num">{{ fa2(t.units) }}</td><td>{{ t.note || '' }}</td></tr>
@else
<tr><td colspan="6" class="sub">تراکنشی ثبت نشده.</td></tr>
@end
</table></div>
@include('partials/foot')
