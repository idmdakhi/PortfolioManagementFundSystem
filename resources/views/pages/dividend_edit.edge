@include('partials/head')
<div class="card"><h2>ویرایش سود تقسیمی — {{ d.scope == 'personal' ? 'حساب شخصی' : 'صندوق' }}</h2>
<form method="POST" action="/dividends/{{ d.id }}">{{ csrfField() }}<input type="hidden" name="scope" value="{{ d.scope }}"><div class="g">
@if(d.scope == 'personal')
<div><label>سرمایه‌گذار</label><select name="investorId" required><option value="">—</option>
@each(i in st.investors)
<option value="{{ i.id }}" {{ i.id == d.investorId ? 'selected' : '' }}>{{ i.name }}</option>
@end
</select></div>
@end
<div><label>مبلغ (ریال)</label><input class="money" inputmode="numeric" name="amount" value="{{ money(d.amount) }}" required></div>
<div><label>تاریخ شمسی</label><input name="occurredOn" dir="ltr" value="{{ jraw(d.occurredOn) }}"></div>
<div><label>یادداشت</label><input name="note" value="{{ d.note || '' }}"></div></div><p><button>ذخیره</button></p></form>
<p><a href="{{ base }}">بازگشت</a></p></div>
@include('partials/foot')
