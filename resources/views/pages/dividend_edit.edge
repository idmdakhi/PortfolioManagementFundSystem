@include('partials/head')
<div class="card"><h2>ویرایش سود تقسیمی</h2>
<form method="POST" action="/dividends/{{ d.id }}">{{ csrfField() }}<div class="g">
<div><label>نوع</label><select name="scope"><option value="fund" {{ d.scope == 'fund' ? 'selected' : '' }}>{{ divFa('fund') }} (بین سرمایه‌گذاران به نسبت واحد تقسیم می‌شود)</option><option value="personal" {{ d.scope == 'personal' ? 'selected' : '' }}>{{ divFa('personal') }}</option></select></div>
<div><label>سرمایه‌گذار (فقط حساب شخصی)</label><select name="investorId"><option value="">—</option>
@each(i in st.investors)
<option value="{{ i.id }}" {{ i.id == d.investorId ? 'selected' : '' }}>{{ i.name }}</option>
@end
</select></div>
<div><label>مبلغ (ریال)</label><input class="money" inputmode="numeric" name="amount" value="{{ money(d.amount) }}" required></div>
<div><label>تاریخ شمسی</label><input name="occurredOn" dir="ltr" value="{{ jraw(d.occurredOn) }}"></div>
<div><label>یادداشت</label><input name="note" value="{{ d.note || '' }}"></div></div><p><button>ذخیره</button></p></form>
<p><a href="/dividends">بازگشت</a></p></div>
@include('partials/foot')
