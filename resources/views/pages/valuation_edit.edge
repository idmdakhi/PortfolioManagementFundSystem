<div class="card"><h2>ویرایش ارزش‌گذاری</h2>
<form method="POST" action="/valuations/{{ v.id }}">{{ csrfField() }}<div class="g">
<div><label>ارزش روز کل صندوق (ریال)</label><input class="money" inputmode="numeric" name="marketValue" value="{{ money(v.marketValue) }}" required></div>
