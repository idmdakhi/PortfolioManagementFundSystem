<form method="POST" action="/dividends">{{ csrfField() }}<div class="g">
<div><label>نوع</label><select name="scope"><option value="fund" {{ false ? 'selected' : '' }}>{{ divFa('fund') }} (بین سرمایه‌گذاران به نسبت واحد تقسیم می‌شود)</option><option value="personal" {{ false ? 'selected' : '' }}>{{ divFa('personal') }}</option></select></div>
