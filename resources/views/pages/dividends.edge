<div class="card sc"><table><tr><th>تاریخ</th><th>نوع</th><th>سرمایه‌گذار</th><th class="num">مبلغ</th><th>یادداشت</th><th></th></tr>
@each(d in list)
<tr><td>{{ jd(d.occurredOn) }}</td><td>{{ divFa(d.scope) }}</td><td>{{ d.investorId ? names.get(d.investorId) : '—' }}</td><td class="num">{{ fa(d.amount) }}</td><td>{{ d.note || '' }}</td>
<td>
@if(auth.user.role == 'admin')
<div class="acts"><a class="btn sm o" href="/dividends/{{ d.id }}/edit">ویرایش</a>
<form method="POST" action="/dividends/{{ d.id }}/delete" data-confirm="حذف شود؟">{{ csrfField() }}<button class="sm danger">حذف</button></form></div>
@end
</td></tr>
