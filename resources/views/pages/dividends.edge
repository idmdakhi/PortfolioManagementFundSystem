@include('partials/head')
<h2>{{ scope == 'personal' ? 'سود تقسیمی حساب‌های شخصی' : 'سود تقسیمی صندوق' }}</h2>
<div class="sub">{{ scope == 'personal' ? 'این سودها فقط به حساب شخصی همان سرمایه‌گذار اضافه می‌شود و به صندوق ربطی ندارد.' : 'سود تقسیمی صندوق بین سرمایه‌گذاران به نسبت واحد تقسیم می‌شود.' }}</div>
@if(auth.user.role == 'admin')
<div class="card"><h2>ثبت سود تقسیمی</h2>
<form method="POST" action="/dividends">{{ csrfField() }}<input type="hidden" name="scope" value="{{ scope }}"><div class="g">
@if(scope == 'personal')
<div><label>سرمایه‌گذار</label><select name="investorId" required><option value="">—</option>
@each(i in st.investors)
<option value="{{ i.id }}">{{ i.name }}</option>
@end
</select></div>
@end
<div><label>مبلغ (ریال)</label><input class="money" inputmode="numeric" name="amount" required></div>
<div><label>تاریخ شمسی</label><input name="occurredOn" dir="ltr" value="{{ today }}"></div>
<div><label>یادداشت</label><input name="note"></div></div><p><button>ثبت</button></p></form>
</div>
@end
<div class="card sc"><table><tr><th>تاریخ</th>
@if(scope == 'personal')
<th>سرمایه‌گذار</th>
@end
<th class="num">مبلغ</th><th>یادداشت</th><th></th></tr>
@each(d in list)
<tr><td>{{ jd(d.occurredOn) }}</td>
@if(scope == 'personal')
<td>{{ d.investorId ? names.get(d.investorId) : '—' }}</td>
@end
<td class="num">{{ fa(d.amount) }}</td><td>{{ d.note || '' }}</td>
<td>
@if(d.locked)
<span class="sub">قفل (دورهٔ بسته)</span>
@elseif(auth.user.role == 'admin')
<div class="acts"><a class="btn sm o" href="/dividends/{{ d.id }}/edit">ویرایش</a>
<form method="POST" action="/dividends/{{ d.id }}/delete" data-confirm="حذف شود؟">{{ csrfField() }}<button class="sm danger">حذف</button></form></div>
@end
</td></tr>
@else
<tr><td colspan="5" class="sub">موردی ثبت نشده.</td></tr>
@end
</table></div>
@include('partials/foot')
