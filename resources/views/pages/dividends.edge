<option value="{{ i.id }}" {{ false ? 'selected' : '' }}>{{ i.name }}</option>
@end
</select></div>
<div><label>مبلغ (ریال)</label><input class="money" inputmode="numeric" name="amount" value="{{ '' }}" required></div>
<div><label>تاریخ شمسی</label><input name="occurredOn" dir="ltr" value="{{ today }}"></div>
<div><label>یادداشت</label><input name="note" value="{{ '' }}"></div></div><p><button>ثبت</button></p></form>
</div>
