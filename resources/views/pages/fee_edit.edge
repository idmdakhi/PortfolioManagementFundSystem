@include('partials/head')
<div class="card"><h2>ویرایش کارمزد ثبت‌شده ({{ feeMethodFa(f.method) }})</h2>
<form method="POST" action="/fees/{{ f.id }}">{{ csrfField() }}<div class="g">
<div><label>نوع</label><select name="scope"><option value="fund" {{ f.scope == 'fund' ? 'selected' : '' }}>کارمزد صندوق</option><option value="personal" {{ f.scope == 'personal' ? 'selected' : '' }}>کارمزد حساب شخصی</option></select></div>
<div><label>سرمایه‌گذار (فقط حساب شخصی)</label><select name="investorId"><option value="">—</option>
@each(i in st.investors)
<option value="{{ i.id }}" {{ i.id == f.investorId ? 'selected' : '' }}>{{ i.name }}</option>
@end
</select></div>
<div><label>مبلغ (ریال)</label><input class="money" inputmode="numeric" name="amount" value="{{ money(f.amount) }}" required></div>
<div><label>تاریخ شمسی</label><input name="occurredOn" dir="ltr" value="{{ jraw(f.occurredOn) }}"></div>
<div><label>یادداشت</label><input name="note" value="{{ f.note || '' }}"></div></div>
<p><button>ذخیره</button> <a href="/fees">بازگشت</a></p></form></div>
@include('partials/foot')
