@include('partials/head')
<div class="card"><h2>ویرایش دورهٔ {{ rep.period.label }} <span class="badge {{ rep.period.status == 'open' ? '' : 'cl' }}">{{ rep.period.status == 'open' ? 'باز' : 'بسته' }}</span></h2>
<form method="POST" action="/periods/{{ rep.period.id }}">{{ csrfField() }}<div class="g">
<div><label>برچسب دوره</label><input name="label"  value="{{ rep.period.label }}" required></div><div><label>شروع (شمسی)</label><input name="startJalali" dir="ltr" value="{{ jraw(rep.period.startOn) }}" required></div><div><label>پایان (شمسی)</label><input name="endJalali" dir="ltr" value="{{ jraw(rep.period.endOn) }}" required></div><div><label>تعداد ماه دوره</label><input name="months" inputmode="decimal" value="{{ rep.period.months }}" required></div><div><label>ارزش روز ابتدای دوره</label><input name="beginMarket" class="money" inputmode="numeric" value="{{ money(rep.period.beginMarket) }}" required></div>
@if(rep.period.status == 'closed')
<div><label>ارزش روز پایانی دوره (ریال)</label><input class="money" inputmode="numeric" name="closeValue" value="{{ money(rep.valuation.latest) }}"></div>
@end
<div><label>واریز ثبت‌شده پیش از سیستم</label><input name="openingDeposits" class="money" inputmode="numeric" value="{{ money(rep.period.openingDeposits) }}" required></div><div><label>برداشت ثبت‌شده پیش از سیستم</label><input name="openingWithdrawals" class="money" inputmode="numeric" value="{{ money(rep.period.openingWithdrawals) }}" required></div><div><label>سود بانکی = سود ثابت مشتری و صندوق (٪ سالانه)</label><input name="fixedRate" inputmode="decimal" value="{{ rep.period.fixedRate }}" required></div><div><label>کارمزد ثابت صندوق (٪)</label><input name="mgmtRate" inputmode="decimal" value="{{ rep.period.mgmtRate }}" required></div><div><label>سهم از مازاد صندوق (٪)</label><input name="excessRate" inputmode="decimal" value="{{ rep.period.excessRate }}" required></div><div><label>سقف کارمزد (ده میلیون ریال)</label><input name="feeCap" inputmode="decimal" value="{{ rep.period.feeCap }}" required></div><div><label>تخفیف و اصلاحات</label><input name="discount" class="money" inputmode="numeric" value="{{ money(rep.period.discount) }}" required></div><div><label>کارمزد ثابت حساب شخصی (٪ سالانه)</label><input name="mgmtRate2" inputmode="decimal" value="{{ rep.period.mgmtRate2 }}" required></div><div><label>سهم از مازاد حساب شخصی (٪)</label><input name="excessRate2" inputmode="decimal" value="{{ rep.period.excessRate2 }}" required></div>
</div><p><button>ذخیره</button> <a href="/periods/manage">بازگشت</a></p></form></div>
@include('partials/foot')
