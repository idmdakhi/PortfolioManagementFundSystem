<!DOCTYPE html>
<html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title ?? 'صندوق سبدگردانی' }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;800&display=swap">
<link rel="stylesheet" href="/app.css"><script src="/app.js" defer></script></head><body><div class="w">
@if(auth.user)
<div class="top noprint"><div><h1>صندوق سبدگردانی خانوادگی</h1><div class="sub">{{ auth.user.fullName || auth.user.email }} ({{ auth.user.role == 'admin' ? 'مدیر' : 'فقط مشاهده' }})</div></div>
<div class="acts"><button type="button" id="fs" class="o sm" hidden>تمام‌صفحه</button><form method="POST" action="/logout">{{ csrfField() }}<button class="o sm">خروج</button></form></div></div>
@let(grp = ['ps', 'psd', 'psf'].includes(nav) ? 'personal' : ['rec', 'fm', 'set', 'op', 'bk', 'au'].includes(nav) ? 'system' : 'fund')
<nav class="noprint main">
<a href="/" class="{{ grp == 'fund' ? 'on' : '' }}">صندوق</a>
<a href="/personal" class="{{ grp == 'personal' ? 'on' : '' }}">حساب شخصی</a>
<a href="/reconciliation" class="{{ grp == 'system' ? 'on' : '' }}">سیستم</a>
</nav>
<nav class="noprint subnav">
@if(grp == 'fund')
<a href="/" class="{{ nav == 'dash' ? 'on' : '' }}">داشبورد</a>
<a href="/periods" class="{{ nav == 'pl' ? 'on' : '' }}">سود و زیان</a>
<a href="/investors" class="{{ nav == 'inv' ? 'on' : '' }}">سرمایه‌گذاران</a>
<a href="/transactions" class="{{ nav == 'tx' ? 'on' : '' }}">تراکنش‌ها</a>
<a href="/movements" class="{{ nav == 'mv' ? 'on' : '' }}">حرکت گروهی</a>
<a href="/areas" class="{{ nav == 'ar' ? 'on' : '' }}">حوزه‌ها</a>
<a href="/dividends" class="{{ nav == 'div' ? 'on' : '' }}">سود تقسیمی</a>
<a href="/valuations" class="{{ nav == 'val' ? 'on' : '' }}">ارزش‌گذاری و دفتر</a>
<a href="/fees" class="{{ nav == 'fee' ? 'on' : '' }}">کارمزدها</a>
@elseif(grp == 'personal')
<a href="/personal" class="{{ nav == 'ps' ? 'on' : '' }}">حساب‌ها</a>
<a href="/personal/dividends" class="{{ nav == 'psd' ? 'on' : '' }}">سود تقسیمی</a>
<a href="/personal/fees" class="{{ nav == 'psf' ? 'on' : '' }}">کارمزدها</a>
@else
<a href="/reconciliation" class="{{ nav == 'rec' ? 'on' : '' }}">تطبیق</a>
<a href="/formulas" class="{{ nav == 'fm' ? 'on' : '' }}">فرمول‌ها</a>
@if(auth.user.role == 'admin')
<a href="/settings" class="{{ nav == 'set' ? 'on' : '' }}">تنظیمات</a>
<a href="/options" class="{{ nav == 'op' ? 'on' : '' }}">فهرست‌ها</a>
<a href="/backup" class="{{ nav == 'bk' ? 'on' : '' }}">پشتیبان‌گیری</a>
<a href="/audit" class="{{ nav == 'au' ? 'on' : '' }}">سابقه</a>
@end
@end
</nav>
@end
@if(flashMessages.has('ok'))
<div class="flash">{{ flashMessages.get('ok') }}</div>
@end
@if(flashMessages.has('error'))
<div class="flash err">{{ flashMessages.get('error') }}</div>
@end
@if(formErrors(flashMessages).length)
<div class="flash err">ورودی‌ها را بررسی کنید:
@each(m in formErrors(flashMessages))
<div dir="auto">{{ m }}</div>
@end
</div>
@end
